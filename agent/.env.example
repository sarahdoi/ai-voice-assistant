# Copy to .env and fill in. Never commit .env.

# LiveKit Cloud project (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Assistant name (spoken and in its instructions) and the LiveKit agent name the
# web app dispatches. AGENT_NAME must match the web app's AGENT_NAME.
APP_NAME=Sarjy
AGENT_NAME=sarjy

# Voice provider: livekit_pipeline (default) | gemini_live | deepgram_cascade (unimplemented)
VOICE_PROVIDER=livekit_pipeline
STT_MODEL=assemblyai/universal-3-6-pro
LLM_MODEL=google/gemma-4-31b-it
TTS_MODEL=fishaudio/s2.1-pro
TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a
LANGUAGE=en
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Puck

# Postgres (Neon) connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Neon: remove &channel_binding=require from the copied URL (asyncpg rejects it).
# Connect timeout allows a sleeping database to wake; query timeout stays short.
DB_CONNECT_TIMEOUT_S=10
DB_TIMEOUT_S=2
# Delete a guest's facts after this many days without a call (0 = keep forever).
MEMORY_RETENTION_DAYS=365

# Topic gate: classifier (rules + LLM label) | rules | off. Empty GUARD_MODEL uses LLM_MODEL.
GUARD_MODE=classifier
GUARD_MODEL=
GUARD_TIMEOUT_S=1.5
# gemini_live skips the topic gate; it refuses to start unless this is true.
ALLOW_UNGATED_REALTIME=false

# Fault injection for reliability demos (never on in normal use)
FAULT_WEATHER=false
FAULT_DB_WRITE=false

# Open-Meteo-compatible endpoints
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_FORECAST_URL=https://api.open-meteo.com/v1/forecast

WEATHER_FALLBACK_URL=https://api.met.no/weatherapi/locationforecast/2.0/compact
WEATHER_USER_AGENT="Sarjy/0.1 github.com/sarahdoi/ai-voice-assistant"
